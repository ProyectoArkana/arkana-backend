# Copia este archivo a .env (en la raíz del monorepo). Todos los servicios lo leen desde aquí.

# --- Seguridad ---
# Obligatorio en producción. En desarrollo hay un valor por defecto, pero cámbialo.
JWT_SECRET=cambia_esto_por_un_secreto_largo
# Clave que usa matchmaking-service para pedirle a match-service que cree una sala.
INTERNAL_API_KEY=cambia_esto_tambien

# --- PostgreSQL (coincide con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=arkana_admin
DB_PASSWORD=secretpassword
DB_NAME=arkana_db
# Alternativa: DATABASE_URL=postgres://usuario:clave@host:5432/base

# --- Puertos y URLs internas ---
# (cada servicio usa su propia variable: AUTH_PORT=3001, USER_PORT=3002, CARD_PORT=3003,
#  MATCHMAKING_PORT=3004, MATCH_PORT=3005; los valores por defecto ya son esos)
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002
CARD_SERVICE_URL=http://127.0.0.1:3003
MATCHMAKING_SERVICE_URL=http://127.0.0.1:3004
MATCH_SERVICE_URL=http://127.0.0.1:3005

# --- Juego ---
# Segundos que un jugador puede estar desconectado antes de perder la partida.
DISCONNECT_GRACE_SECONDS=30
