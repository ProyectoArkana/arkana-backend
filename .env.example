# Plantilla de variables de entorno (SIN valores reales).
# En el servidor: copiar a .env (o shared/.env) y completar. Nunca subir .env al repositorio.
NODE_ENV=preproduction

# API Gateway
PORT=3000
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002
CARD_SERVICE_URL=http://127.0.0.1:3003

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=<definir-en-el-servidor>

# Base de datos PostgreSQL de preproduccion
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=arkana_preprod
DB_PASSWORD=<definir-en-el-servidor>
DB_NAME=arkana_preprod
